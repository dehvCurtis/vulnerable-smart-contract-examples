   ├─ Detector: restaking-slashing-conditions
   └─ Fix: Implement two-step slashing with delay:

uint256 public constant SLASHING_DELAY = 7 days;

struct SlashingRequest {
address operator;
uint256 amount;
bytes evidence;
uint256 timestamp;
bool executed;
}

mapping(bytes32 => SlashingRequest) public slashingRequests;

function requestSlashing(
address operator,
uint256 amount,
bytes calldata evidence
) external onlyAVS returns (bytes32 requestId) {
requestId = keccak256(abi.encode(msg.sender, operator, amount, block.timestamp));
slashingRequests[requestId] = SlashingRequest({
operator: operator,
amount: amount,
evidence: evidence,
timestamp: block.timestamp,
executed: false
});
}

function executeSlashing(bytes32 requestId) external {
SlashingRequest storage request = slashingRequests[requestId];
require(!request.executed, "Already executed");
require(
block.timestamp >= request.timestamp + SLASHING_DELAY,
"Delay period not elapsed - operator can still appeal"
);

stakes[request.operator] -= request.amount;
request.executed = true;
}

function appealSlashing(bytes32 requestId, bytes calldata defense) external {
SlashingRequest storage request = slashingRequests[requestId];
require(msg.sender == request.operator, "Not operator");
require(!request.executed, "Already executed");
require(
block.timestamp < request.timestamp + SLASHING_DELAY,
"Appeal period expired"
);

emit SlashingAppealed(requestId, defense);
// Governance reviews appeal
}

