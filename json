uint256 public constant LIQUIDITY_RESERVE_PERCENTAGE = 10;  // 10% liquid
uint256 public totalAvailableLiquidity;

function deposit(uint256 assets) external {
asset.transferFrom(msg.sender, address(this), assets);

// Keep 10% liquid for immediate withdrawals
uint256 toLiquidity = (assets * LIQUIDITY_RESERVE_PERCENTAGE) / 100;
uint256 toRestake = assets - toLiquidity;

totalAvailableLiquidity += toLiquidity;

// Restake 90% to EigenLayer
eigenlayer.deposit(toRestake);

_mint(msg.sender, assets);
}

function completeWithdrawal() external {
WithdrawalRequest storage request = withdrawalRequests[msg.sender];

require(
totalAvailableLiquidity >= request.assets,
"Insufficient liquidity - please try later"
);

totalAvailableLiquidity -= request.assets;
asset.transfer(msg.sender, request.assets);
}

This prevents Renzo-style incidents where withdrawals are impossible.

